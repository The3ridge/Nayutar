{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git remote update:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote add:*)",
      "Bash(gh repo sync:*)",
      "Bash(gh release upload:*)",
      "Bash(gh release create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(lake comparator --inadvisably-no-sandbox:*)",
      "Bash(lake update:*)",
      "Edit(.git/**)",
      "Edit(**/secrets/**)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(~/.config/kisage/**)",
      "Edit(~/.local/state/kisage/**)",
      "Edit(spec/comparator.json)",
      "Edit(spec/Nayutar/Statements.lean)",
      "Edit(spec/Nayutar/Statements/**)",
      "Edit(spec/Nayutar/Fixture.lean)",
      "Edit(spec/Nayutar/Fixture/**)",
      "Edit(spec/lakefile.toml)",
      "Edit(spec/lakefile.lean)",
      "Edit(spec/lake-manifest.json)",
      "Edit(spec/lean-toolchain)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-harness/harness_selfcheck.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-harness/guard_push_commands.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-harness/guard_protected_paths.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-harness/post_edit_checks.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
