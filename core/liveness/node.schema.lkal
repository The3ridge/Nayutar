@lkal "0.1"

lkal-schema = "0.2"
id = "nayutar:sys/node/0.1"
version = "0.1.0"
doc = "Schema for node liveness records under /sys/nodes/<node>."

root {
  field "evictable" {
    type = .bool
    required = true
  }
  field "rack" {
    type = .string
    required = true
    min-length = 1
    max-length = 63
    pattern = "[a-z0-9]([a-z0-9-]*[a-z0-9])?"
  }
  field "since" {
    type = .int
    required = true
    min = 0
    max = 9007199254740991
  }
  field "state" {
    type = .enum
    required = true
    values = [.pending, .ready, .notready]
  }
}
