@lkal "0.1"

lkal-schema = "0.2"
id = "nayutar:core/wire-watch-event/0.1"
version = "0.2.0"
doc = "Streaming watch event schema."

def "target" {
  type = .record
  field "group" {
    type = .string
    min-length = 3
    max-length = 253
    pattern = "[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+"
  }
  field "kind" {
    type = .string
    required = true
    min-length = 1
    max-length = 63
    pattern = "[a-z0-9]([a-z0-9-]*[a-z0-9])?"
  }
  field "name" {
    type = .string
    required = true
    min-length = 1
    max-length = 253
    pattern = "[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*"
  }
}

def "diagnostic" {
  type = .record
  field "order" {
    type = .int
    required = true
  }
  field "code" {
    type = .string
    required = true
    pattern = "K(101|102|201|202|203|204|206|301|302|401|502|602|603|604)"
  }
  field "path" {
    type = .string
    min-length = 1
  }
  field "reason" {
    type = .string
    required = true
    min-length = 1
  }
  field "nextAction" {
    type = .string
    min-length = 1
  }
}

def "error" {
  type = .record
  field "kind" {
    type = .enum
    required = true
    values = [.badRequest, .unauthorized, .forbidden, .notFound, .methodNotAllowed, .notAcceptable, .conflict, .gone, .tooLarge, .unsupportedMediaType, .unprocessable, .observed, .refKind, .refNotFound, .pathNotFound, .internal, .unavailable]
  }
  field "status" {
    type = .int
    required = true
    min = 400
    max = 599
  }
  field "code" {
    type = .string
    pattern = "K(101|102|201|202|203|204|206|301|302|401|502|602|603|604)"
  }
  field "path" {
    type = .string
    min-length = 1
  }
  field "message" {
    type = .string
    required = true
    min-length = 1
  }
  field "diagnostics" {
    type = .map
    unique-by = ["order"]
    value { use = &def/diagnostic }
  }
}

root {
  field "type" {
    type = .enum
    required = true
    values = [.put, .delete, .bookmark, .error]
  }
  field "revision" {
    type = .int
    min = 0
  }
  field "initialEventsEnd" { type = .bool }
  field "object" {
    type = .record
    open = true
  }
  field "target" { use = &def/target }
  field "error" { use = &def/error }
}
