@lkal "0.1"

lkal-schema = "0.2"
id = "nayutar:core/wire-watch-event/0.1"
version = "0.1.0"
doc = "Streaming watch event schema."

def "target" {
  type = .record
  field "group" {
    type = .string
    min-length = 3
    max-length = 253
    pattern = "[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+"
  }
  field "kind" {
    type = .string
    required = true
    min-length = 1
    max-length = 63
    pattern = "[a-z0-9]([a-z0-9-]*[a-z0-9])?"
  }
  field "name" {
    type = .string
    required = true
    min-length = 1
    max-length = 253
    pattern = "[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*"
  }
}

def "error" {
  type = .record
  field "kind" {
    type = .enum
    required = true
    values = [.badRequest, .unauthorized, .forbidden, .notFound, .methodNotAllowed, .notAcceptable, .conflict, .gone, .tooLarge, .unsupportedMediaType, .unprocessable, .observed, .refKind, .refNotFound, .pathNotFound, .internal, .unavailable]
  }
  field "status" {
    type = .int
    required = true
    min = 400
    max = 599
  }
  field "path" {
    type = .string
    min-length = 1
  }
  field "message" {
    type = .string
    required = true
    min-length = 1
  }
}

root {
  field "type" {
    type = .enum
    required = true
    values = [.put, .delete, .bookmark, .error]
  }
  field "revision" {
    type = .int
    min = 0
  }
  field "initialEventsEnd" { type = .bool }
  field "object" {
    type = .record
    open = true
  }
  field "target" { use = &def/target }
  field "error" { use = &def/error }
}
