{
  "description": "Agent harness: session-start self-check, PreToolUse guards for protected paths and shell commands, and PostToolUse checks for LKAL and settled ADRs.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/harness_selfcheck.py\" --hook",
            "timeout": 30,
            "statusMessage": "Running agent harness self-check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/guard_protected_paths.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/guard_push_commands.py\"",
            "timeout": 10,
            "statusMessage": "Checking push-class commands"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/post_edit_checks.py\"",
            "timeout": 30,
            "statusMessage": "Running post-edit checks"
          }
        ]
      }
    ]
  }
}
